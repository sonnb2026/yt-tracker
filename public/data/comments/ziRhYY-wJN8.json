    {
      "id": "UgwTIFiJnTQTQb0DAPB4AaABAg",
      "author": "@Reallifeinsights.tv26",
      "authorImage": "https://yt3.ggpht.com/xxFRoToxoEPU0jqZli8MDif3KYcq2Y58xLrT3i6u-mAOtFwS6qDk4MPR6Z8ycS7mqsr-WZTDpg=s48-c-k-c0x00ffffff-no-rj",
      "text": "Shibam looks like something out of a sci-fi movie. Mud skyscrapers standing strong since the 16th century is just unbelievable architecture.",
      "likeCount": 1,
      "publishedAt": "2026-10-02T03:53:27Z",
      "replyCount": 1,
      "replies": [
        {
          "id": "UgwTIFiJnTQTQb0DAPB4AaABAg.AbS3y84wDMjAbS6LUhSggs",
          "author": "@Globallife.documentary",
          "authorImage": "https://yt3.ggpht.com/UT4yqZ2DrZ2fBIIQWOCcVrQYBje265v4HWuZn65ElT3j5IRtHyIw-Ezzb6kX6kLSxPFTaiT5EkE=s48-c-k-c0x00ffffff-no-rj",
          "text": "Spot on! it genuinely feels like an ancient sci-fi civilization. The sheer architectural brilliance of building the world's first high-rises out of simple mud and straw centuries before modern steel is mind-blowing.",
          "likeCount": 0,
          "publishedAt": "2026-10-02T04:14:15Z"
        }
      ]
    },
    {
      "id": "UgwtFFpkRjqCM3gNZ6B4AaABAg",
      "author": "@GlobalLifeInsights",
      "authorImage": "https://yt3.ggpht.com/A99MvFbJzMZ0lVwUSmZjto6B1Qeywpg3YEkC9s0_AipfSZl93DMruPX8aLWR372u9aRQa7Hfw94=s48-c-k-c0x00ffffff-no-rj",
      "text": "Slab City really made me pause... Is surviving 110° heat with zero plumbing worth 100% total freedom? Be honest, would you guys attempt living there for 6 months?",
      "likeCount": 1,
      "publishedAt": "2026-10-02T02:49:39Z",
      "replyCount": 1,
      "replies": [
        {
          "id": "UgwtFFpkRjqCM3gNZ6B4AaABAg.AbRxerJ1wUYAbS6gX2z3ob",
          "author": "@Globallife.documentary",
          "authorImage": "https://yt3.ggpht.com/UT4yqZ2DrZ2fBIIQWOCcVrQYBje265v4HWuZn65ElT3j5IRtHyIw-Ezzb6kX6kLSxPFTaiT5EkE=s48-c-k-c0x00ffffff-no-rj",
          "text": "Visiting to experience the vibrant folk art like Salvation Mountain is fascinating, but enduring months of triple-digit desert heat where water is a literal life-or-death countdown is a whole different reality. Massive respect to the year-round residents who manage to thrive on their own terms.",
          "likeCount": 0,
          "publishedAt": "2026-10-02T04:17:16Z"
        }
      ]
    },
