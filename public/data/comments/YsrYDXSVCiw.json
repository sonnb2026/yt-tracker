    {
      "id": "Ugy6Jxi74J0YuAqBwPN4AaABAg",
      "author": "@marlinpruett8343",
      "authorImage": "https://yt3.ggpht.com/ytc/AIdro_lagYOENBZLPYzk7LgACbnkqEM6wrUGsQts1Hunr4hQ_2s=s48-c-k-c0x00ffffff-no-rj",
      "text": "I can tell you from living in Brazil for 6 months South Paula is not the city you need to be in, there's a lot of smaller cities that is much much friendlier and much better and way way way cleaner",
      "likeCount": 0,
      "publishedAt": "2026-07-18T13:32:29Z",
      "replyCount": 1,
      "replies": [
        {
          "id": "Ugy6Jxi74J0YuAqBwPN4AaABAg.AZPPoZLNPqlAZUEWPdyjR9",
          "author": "@AmazingGlobalDiscoveries",
          "authorImage": "https://yt3.ggpht.com/T2v50f6Jyxr5W4Rgq36zJV5ZHEJoK26sCLPrt8u9s0ecJuedWFhcgw42MdyvKjOVmgzbVSm3Qw=s48-c-k-c0x00ffffff-no-rj",
          "text": "São Paulo can definitely feel very different from Brazil’s smaller cities, especially when it comes to cleanliness, pace of life, and friendliness.",
          "likeCount": 0,
          "publishedAt": "2026-07-20T10:29:57Z"
        }
      ]
    },
    {
      "id": "UgwZ07M1RqTfvN013hl4AaABAg",
      "author": "@marlinpruett8343",
